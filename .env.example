# ------------------------------------------------------------
# 家計簿アプリ 環境変数サンプル
# このファイルをコピーして .env.local という名前で保存し、値を書き換えてください。
#   コピー方法(Windows PowerShell): Copy-Item .env.example .env.local
#   コピー方法(Mac/Linux):          cp .env.example .env.local
# .env.local は .gitignore 済みなので、Git には保存されません。
# ------------------------------------------------------------

# Supabase の「Project URL」
# 取得場所: Supabase ダッシュボード > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase の公開用APIキー（anon / publishable key）
# 取得場所: Supabase ダッシュボード > Project Settings > API Keys > anon public
# これはブラウザに公開されて良いキーです。RLS で保護されます。
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 【重要】service_role キーはこのアプリでは使いません。絶対にここに書かないでください。
